{
  "id": "default-dark",
  "name": "Default Dark",
  "appearance": "dark",
  "version": "1.0.0",
  "author": "FreyaCN",
  "semantic": {
    "background": "{neutral.950}",
    "foreground": "{neutral.50}",
    "card": "{neutral.900}",
    "cardForeground": "{neutral.50}",
    "popover": "{neutral.800}",
    "popoverForeground": "{neutral.50}",
    "primary": "{neutral.50}",
    "primaryForeground": "{neutral.900}",
    "secondary": "{neutral.800}",
    "secondaryForeground": "{neutral.50}",
    "muted": "{neutral.800}",
    "mutedForeground": "{neutral.400}",
    "accent": "{neutral.700}",
    "accentForeground": "{neutral.50}",
    "destructive": "{red.400}",
    "destructiveForeground": "{neutral.50}",
    "border": "{neutral.50}/10",
    "input": "{neutral.50}/15",
    "ring": "{neutral.500}",
    "disabled": "{neutral.800}",
    "disabledForeground": "{neutral.500}",
    "sidebar": "{neutral.900}",
    "sidebarForeground": "{neutral.50}",
    "sidebarPrimary": "{blue.500}",
    "sidebarPrimaryForeground": "{neutral.50}",
    "sidebarAccent": "{neutral.800}",
    "sidebarAccentForeground": "{neutral.50}",
    "sidebarBorder": "{neutral.50}/10",
    "sidebarRing": "{neutral.500}",
    "chart1": "{blue.500}",
    "chart2": "{emerald.400}",
    "chart3": "{orange.400}",
    "chart4": "{violet.500}",
    "chart5": "{rose.500}",
    "heroGradient": {
      "linear": {
        "angle": 135,
        "stops": [
          {
            "color": "{blue.700}",
            "at": 0
          },
          {
            "color": "{violet.600}",
            "at": 100
          }
        ]
      }
    }
  },
  "components": {
    "button": {
      "fontWeight": "medium",
      "fontSize": "sm",
      "primary": {
        "background": "{semantic.primary}",
        "foreground": "{semantic.primaryForeground}",
        "radius": "md",
        "hover": {
          "background": "{neutral.200}"
        },
        "active": {
          "background": "{neutral.300}"
        },
        "focus-visible": {
          "border": "{semantic.ring}"
        },
        "disabled": {
          "background": "{semantic.disabled}",
          "foreground": "{semantic.disabledForeground}"
        }
      },
      "secondary": {
        "background": "{semantic.secondary}",
        "foreground": "{semantic.secondaryForeground}",
        "radius": "md",
        "hover": {
          "background": "{neutral.700}"
        },
        "active": {
          "background": "{neutral.600}"
        },
        "disabled": {
          "background": "{semantic.disabled}",
          "foreground": "{semantic.disabledForeground}"
        }
      },
      "destructive": {
        "background": "{semantic.destructive}",
        "foreground": "{semantic.destructiveForeground}",
        "radius": "md",
        "hover": {
          "background": "{red.500}"
        },
        "active": {
          "background": "{red.600}"
        }
      },
      "outline": {
        "background": "transparent",
        "foreground": "{semantic.foreground}",
        "border": "{semantic.border}",
        "radius": "md",
        "hover": {
          "background": "{neutral.800}"
        },
        "active": {
          "background": "{neutral.700}"
        }
      },
      "ghost": {
        "background": "transparent",
        "foreground": "{semantic.foreground}",
        "radius": "md",
        "hover": {
          "background": "{neutral.800}"
        },
        "active": {
          "background": "{neutral.700}"
        }
      },
      "link": {
        "background": "transparent",
        "foreground": "{semantic.primary}",
        "radius": "sm",
        "hover": {
          "foreground": "{blue.400}"
        }
      }
    },
    "input": {
      "background": "transparent",
      "foreground": "{semantic.foreground}",
      "border": "{semantic.input}",
      "placeholder": "{semantic.mutedForeground}",
      "radius": "md",
      "focus-visible": {
        "border": "{semantic.ring}"
      },
      "invalid": {
        "border": "{semantic.destructive}"
      },
      "disabled": {
        "background": "{semantic.disabled}",
        "foreground": "{semantic.disabledForeground}"
      }
    },
    "card": {
      "background": "{semantic.card}",
      "foreground": "{semantic.cardForeground}",
      "border": "{semantic.border}",
      "radius": "lg"
    },
    "popover": {
      "background": "{semantic.popover}",
      "foreground": "{semantic.popoverForeground}",
      "border": "{semantic.border}",
      "radius": "md"
    },
    "tooltip": {
      "background": "{semantic.primary}",
      "foreground": "{semantic.primaryForeground}",
      "radius": "sm",
      "fontSize": "xs"
    },
    "badge": {
      "fontSize": "xs",
      "fontWeight": "medium",
      "default": {
        "background": "{semantic.primary}",
        "foreground": "{semantic.primaryForeground}",
        "radius": "full"
      },
      "secondary": {
        "background": "{semantic.secondary}",
        "foreground": "{semantic.secondaryForeground}",
        "radius": "full"
      },
      "destructive": {
        "background": "{semantic.destructive}",
        "foreground": "{semantic.destructiveForeground}",
        "radius": "full"
      },
      "outline": {
        "background": "transparent",
        "foreground": "{semantic.foreground}",
        "border": "{semantic.border}",
        "radius": "full"
      }
    },
    "switch": {
      "track": {
        "background": "{neutral.700}",
        "checked": {
          "background": "{semantic.primary}"
        },
        "disabled": {
          "background": "{semantic.disabled}"
        }
      },
      "thumb": {
        "background": "{neutral.50}",
        "disabled": {
          "background": "{neutral.400}"
        }
      }
    },
    "checkbox": {
      "background": "transparent",
      "border": "{semantic.input}",
      "radius": "sm",
      "checked": {
        "background": "{semantic.primary}",
        "foreground": "{semantic.primaryForeground}"
      },
      "focus-visible": {
        "border": "{semantic.ring}"
      },
      "disabled": {
        "background": "{semantic.disabled}",
        "foreground": "{semantic.disabledForeground}"
      }
    },
    "select": {
      "background": "{semantic.background}",
      "foreground": "{semantic.foreground}",
      "border": "{semantic.input}",
      "radius": "md",
      "item": {
        "hover": {
          "background": "{semantic.accent}"
        },
        "selected": {
          "background": "{semantic.accent}"
        }
      }
    },
    "tabs": {
      "list": {
        "background": "{semantic.muted}"
      },
      "trigger": {
        "foreground": "{semantic.mutedForeground}",
        "hover": {
          "foreground": "{semantic.foreground}"
        },
        "active": {
          "background": "{semantic.background}",
          "foreground": "{semantic.foreground}"
        }
      },
      "radius": "md"
    }
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 10,
    "xl": 14,
    "full": 9999
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, system-ui, -apple-system, sans-serif",
      "mono": "JetBrains Mono, ui-monospace, monospace",
      "serif": "Georgia, serif"
    },
    "fontSize": {
      "xs": [
        12,
        16
      ],
      "sm": [
        14,
        20
      ],
      "base": [
        16,
        24
      ],
      "lg": [
        18,
        28
      ],
      "xl": [
        20,
        28
      ],
      "2xl": [
        24,
        32
      ],
      "3xl": [
        30,
        36
      ],
      "4xl": [
        36,
        40
      ]
    },
    "fontWeight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "shadows": {
    "xs": "0 1px 2px 0 rgb(0 0 0 / 0.3)",
    "sm": "0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.4)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.4)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.4)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 0.4), 0 8px 10px -6px rgb(0 0 0 / 0.4)"
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 150,
      "normal": 250,
      "slow": 350
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "zIndex": {
    "hide": -1,
    "base": 0,
    "docked": 10,
    "dropdown": 1000,
    "sticky": 1100,
    "banner": 1200,
    "overlay": 1300,
    "modal": 1400,
    "popover": 1500,
    "skipLink": 1600,
    "toast": 1700,
    "tooltip": 1800
  }
}